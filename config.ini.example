# 超新星 · 学习助手 - 命令行配置文件示例
# 使用方法：复制此文件为 config.ini，然后修改下面的配置
# Web 工作台不读取此文件，账户与答题连接在页面中设置。

[common]
# 手机号（必填）
username = 

# 密码（必填）
password = 

# 是否使用 cookies 登录（可选，设为 true 则忽略账号密码）
use_cookies = false

# 要学习的课程ID列表，多个用逗号分隔（可选，留空则学习全部课程）
# 例如: course_list = 123456,789012
course_list = 

# 视频播放速度（1.0-2.0）
speed = 1.0

# 同时进行的章节数
jobs = 4

# 遇到未开放章节的处理方式: retry-稍后重试, continue-跳过
notopen_action = retry


[tiku]
# 题库提供方: AI, SiliconFlow, TikuYanxi, TikuLike, TikuAdapter
# 留空则不自动答题
provider = AI

# 是否自动提交: true-全部题目都有答案时提交, false-只保存不提交
submit = false

# AI 题库配置（provider = AI 时生效，兼容 OpenAI Chat Completions）
# 完整的接口地址
endpoint = https://api.openai.com/v1/chat/completions

# API 密钥
key = 

# 模型名称
model = gpt-4o-mini

# 请求间隔（秒）
min_interval_seconds = 3

# 判断题答案映射（逗号分隔，可选）
true_list = 正确,对,√,是
false_list = 错误,错,×,否


[notification]
# 通知提供方: ServerChan, Qmsg, Bark, Telegram
# 留空则不发送通知
provider = 

# 推送地址（四种通知方式都需要）
url = 

# Telegram 聊天 ID（provider = Telegram 时需要）
tg_chat_id = 
