# Credentials are entered in the Web Settings page and stored in the data volume.
# Optional: reuse an existing installation's data volume when upgrading.
# SUPERNOVA_DATA_VOLUME=your-existing-data-volume
# SUPERNOVA_DATA_EXTERNAL=true
# Optional: extra host names allowed to reach the Web UI (reverse proxy / LAN).
# SUPERNOVA_ALLOWED_HOSTS=study.example.com
